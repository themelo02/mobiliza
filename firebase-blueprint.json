{
  "entities": {
    "Supervisor": {
      "title": "Supervisor",
      "description": "Supervisor de mobilização social cadastrado para o município do Sumbe",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "codigo": { "type": "string" },
        "nome": { "type": "string" },
        "telefone": { "type": "string" },
        "provincia": { "type": "string" },
        "municipio": { "type": "string" },
        "comuna": { "type": "string" },
        "coordenacao": { "type": "string" },
        "ativo": { "type": "boolean" },
        "dataCriacao": { "type": "string" }
      },
      "required": ["id", "codigo", "nome", "comuna", "coordenacao", "ativo"]
    },
    "Submissao": {
      "title": "Submissao",
      "description": "Submissão de fichas de atividade coletadas pelos supervisores no Sumbe",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "supervisorId": { "type": "string" },
        "supervisorNome": { "type": "string" },
        "provincia": { "type": "string" },
        "municipio": { "type": "string" },
        "data": { "type": "string" },
        "dataEnvio": { "type": "string" },
        "totalPessoas": { "type": "number" },
        "totalLocais": { "type": "number" },
        "totalSim": { "type": "number" },
        "totalNao": { "type": "number" },
        "status": { "type": "string" },
        "observacoes": { "type": "string" }
      },
      "required": ["id", "supervisorId", "supervisorNome", "data", "totalPessoas", "status"]
    },
    "SystemConfig": {
      "title": "SystemConfig",
      "description": "Configurações globais do sistema, como código de acesso do administrador e estado de inicialização",
      "type": "object",
      "properties": {
        "adminCode": { "type": "string" },
        "seedInitialized": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      }
    },
    "Coordenacao": {
      "title": "Coordenacao",
      "description": "Coordenação de mobilização social no município do Sumbe com 1 a 2 supervisores atribuídos",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nome": { "type": "string" },
        "descricao": { "type": "string" },
        "municipio": { "type": "string" },
        "comuna": { "type": "string" },
        "limiteSupervisores": { "type": "number" },
        "dataCriacao": { "type": "string" }
      },
      "required": ["id", "nome", "municipio", "comuna", "limiteSupervisores"]
    }
  },
  "firestore": {
    "/supervisores/{supervisorId}": {
      "schema": { "$ref": "#/entities/Supervisor" },
      "description": "Registo dos supervisores do município do Sumbe"
    },
    "/submissoes/{submissaoId}": {
      "schema": { "$ref": "#/entities/Submissao" },
      "description": "Relatórios e fichas de campo enviados pelos supervisores"
    },
    "/config/{configId}": {
      "schema": { "$ref": "#/entities/SystemConfig" },
      "description": "Configurações gerais do sistema e código de administração"
    },
    "/coordenacoes/{coordenacaoId}": {
      "schema": { "$ref": "#/entities/Coordenacao" },
      "description": "Coordenações de campo com 1 a 2 supervisores atribuídos"
    }
  }
}
